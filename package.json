{
  "name": "toastin-it",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && markdownlint-cli2 README.md 'docs/**/*.md' 'src/content/**/*.md'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "search:index": "pagefind --site dist",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run search:index"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-frames": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "astro": "^7.1.6",
    "astro-expressive-code": "^0.44.1",
    "expressive-code": "^0.44.1",
    "@fontsource-variable/geist": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "mermaid": "^11.12.2",
    "pagefind": "^1.5.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2"
  }
}
