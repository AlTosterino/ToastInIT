---
import BaseLayout from '../layouts/BaseLayout.astro';
import { author, breadcrumbs } from '../lib/site';
const description =
  'About Daniel Różycki, a Software Architect and Senior Python Engineer writing about Python systems, distributed architecture and applied AI.';
const profileJsonLd = {
  '@type': 'ProfilePage',
  '@id': 'https://toastin.it/about/#profile',
  name: 'About Daniel Różycki',
  url: 'https://toastin.it/about/',
  mainEntity: { '@id': author.id },
};
---

<BaseLayout
  title="About Daniel Różycki — toastin.it"
  description={description}
  canonical="/about/"
  image="/og/about.png"
  jsonLd={[
    profileJsonLd,
    breadcrumbs([
      { name: 'Home', url: '/' },
      { name: 'About', url: '/about/' },
    ]),
  ]}
  ><div class="wrap page-intro narrow">
    <p class="eyebrow">About</p><h1>Daniel Różycki</h1><p class="lead">
      Daniel Różycki is a Software Architect and Senior Python Engineer focused on software
      architecture, distributed systems and AI-assisted software development. He writes about
      practical engineering decisions, trade-offs and the tools that support production work.
    </p><div class="link-row">
      <a class="text-link" href="https://github.com/AlTosterino">GitHub ↗</a><a
        class="text-link"
        href="https://www.linkedin.com/in/daniel-rozycki/">LinkedIn ↗</a
      ><a class="text-link" href="https://rozycki.dev">rozycki.dev ↗</a>
    </div>
    <h2>What I write about</h2><p>
      Architecture decisions, Python services, distributed workflows, platform engineering and
      applied AI for software teams.
    </p>
    <h2>How I work</h2><p>
      I care about clear boundaries, explicit trade-offs and systems that remain understandable
      after the original context is gone.
    </p>
  </div></BaseLayout
>
