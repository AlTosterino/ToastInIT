---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles } from '../lib/content';
const articles = await getArticles();
const featured = articles.filter((article) => article.data.featured).slice(0, 3);
const topics = [...new Set(articles.flatMap((article) => article.data.tags))].slice(0, 8);
---

<BaseLayout>
  <div class="wrap home">
    <section class="intro">
      <p class="eyebrow">Daniel Różycki</p><h1>
        Software architecture, Python and AI engineering.
      </h1><p class="intro-copy">
        Practical notes about the decisions, trade-offs and tools that shape reliable software.
      </p>
    </section>
    {
      featured.length > 0 && (
        <section class="section-block">
          <>
            <div class="section-heading">
              <>
                <p class="eyebrow">Selected writing</p>
                <a class="text-link" href="/articles">
                  All articles →
                </a>
              </>
            </div>
            <div class="featured-grid">
              {featured.map((article) => (
                <ArticleCard article={article} />
              ))}
            </div>
          </>
        </section>
      )
    }
    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Latest articles</p><a class="text-link" href="/articles"
          >Browse archive →</a
        >
      </div><ArticleList articles={articles.slice(0, 8)} />
    </section>
    {
      topics.length > 0 && (
        <section class="section-block topics-strip">
          <>
            <p class="eyebrow">Topics</p>
            <div class="topic-links">
              {topics.map((topic) => (
                <a href={`/topics/${topic.toLowerCase().replaceAll(' ', '-')}/`}>{topic}</a>
              ))}
            </div>
          </>
        </section>
      )
    }
  </div>
</BaseLayout>
