---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles } from '../lib/content';
const articles = await getArticles();
const topics = [...new Set(articles.flatMap((article) => article.data.tags))].slice(0, 8);
---

<BaseLayout>
  <div class="wrap home">
    <section class="intro">
      <p class="eyebrow">Daniel Różycki / Notes</p><h1>
        Software architecture, Python and the crumbs between decisions.
      </h1><p class="intro-copy">
        Practical notes on reliable systems, distributed workflows and the trade-offs behind
        production software.
      </p>
    </section>
    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Writing</p><a class="text-link" href="/articles">Full index →</a>
      </div><ArticleList articles={articles.slice(0, 8)} />
    </section>
    {
      topics.length > 0 && (
        <section class="section-block topics-strip">
          <>
            <p class="eyebrow">Browse by subject</p>
            <div class="topic-links topic-links-inline">
              {topics.map((topic) => (
                <a href={`/topics/${topic.toLowerCase().replaceAll(' ', '-')}/`}>{topic}</a>
              ))}
            </div>
          </>
        </section>
      )
    }
  </div>
</BaseLayout>
