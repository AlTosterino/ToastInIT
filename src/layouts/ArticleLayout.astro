---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingTime, type Article } from '../lib/content';
import { absoluteUrl, author, breadcrumbs, ogImage } from '../lib/site';
const { article } = Astro.props as { article: Article };
const { Content, headings } = await render(article);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const articleUrl = absoluteUrl(article.data.canonicalUrl ?? `/articles/${article.id}/`);
const imagePath = article.data.ogImage ?? `/og/articles/${article.id}.png`;
const articleJsonLd = {
  '@type': 'TechArticle',
  '@id': `${articleUrl}#article`,
  headline: article.data.title,
  description: article.data.description,
  image: ogImage(imagePath),
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
  mainEntityOfPage: articleUrl,
  author: { '@id': author.id },
  publisher: { '@id': author.id },
  keywords: article.data.tags,
  inLanguage: article.data.language,
};
const breadcrumbJsonLd = breadcrumbs([
  { name: 'Home', url: '/' },
  { name: 'Writing', url: '/articles/' },
  { name: article.data.title, url: articleUrl },
]);
---

<BaseLayout
  title={`${article.data.title} — toastin.it`}
  description={article.data.description}
  canonical={articleUrl}
  type="article"
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  noindex={article.data.noindex}
  language={article.data.language}
  image={imagePath}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <div class="article-shell wrap">
    <article class="prose" data-pagefind-body>
      <header class="article-header">
        <div class="eyebrow">{article.data.series ?? 'Article'}</div><h1>{article.data.title}</h1><p
          class="lead"
        >
          {article.data.description}
        </p><div class="article-meta">
          <time datetime={article.data.publishedAt.toISOString()}
            >Published {formatDate(article.data.publishedAt, article.data.language)}</time
          >{
            article.data.updatedAt && (
              <time datetime={article.data.updatedAt.toISOString()}>
                Updated {formatDate(article.data.updatedAt, article.data.language)}
              </time>
            )
          }
        </div><div class="tag-list">
          {
            article.data.tags.map((tag) => (
              <a href={`/topics/${tag.toLowerCase().replaceAll(' ', '-')}/`}>#{tag}</a>
            ))
          }
        </div>
      </header>
      <div class="article-content"><Content /></div>
      <footer class="article-footer">
        <div class="article-share" aria-label="Share this article">
          <p class="eyebrow">Share this note</p>
          <div class="share-actions">
            <a class="share-button" data-share-x target="_blank" rel="noopener noreferrer">X</a>
            <a class="share-button" data-share-mastodon target="_blank" rel="noopener noreferrer"
              >Mastodon</a
            >
            <a class="share-button" data-share-linkedin target="_blank" rel="noopener noreferrer"
              >LinkedIn</a
            >
            <button type="button" class="share-button" data-copy-article>Copy link</button>
            <span class="share-feedback" data-share-feedback aria-live="polite"></span>
          </div>
        </div>
        <div class="article-author">
          <p class="eyebrow">About the author</p>
          <strong>Daniel Różycki</strong>
          <span>Software Architect and Senior Python Engineer</span>
          <div class="link-row">
            <a class="text-link" href="/about/">About ↗</a><a
              class="text-link"
              href="https://rozycki.dev">rozycki.dev ↗</a
            >
          </div>
        </div>
        {
          article.data.repository && (
            <a class="text-link" href={article.data.repository}>
              View repository ↗
            </a>
          )
        }
      </footer>
    </article>
    {
      toc.length > 0 && (
        <aside class="toc" aria-label="On this page">
          <>
            <div
              class="reading-status"
              data-reading-minutes={readingTime(article.body)}
              aria-live="off"
            >
              <span>{readingTime(article.body)} min read</span>
              <span data-reading-progress>0% read</span>
              <span class="reading-progress-bar">
                <span data-reading-progress-bar />
              </span>
            </div>
            <p class="eyebrow">On this page</p>
            <ul>
              {toc.map((heading) => (
                <li class={`toc-depth-${heading.depth}`}>
                  <a data-toc-link={heading.slug} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </>
        </aside>
      )
    }
  </div>
</BaseLayout>
<script>
  document
    .querySelectorAll('.article-content h2[id], .article-content h3[id], .article-content h4[id]')
    .forEach((heading) => {
      const button = document.createElement('button');
      button.className = 'heading-link';
      button.type = 'button';
      button.title = 'Copy link to this heading';
      button.setAttribute('aria-label', `Copy link to ${heading.textContent ?? 'heading'}`);
      button.textContent = '#';
      button.addEventListener('click', async () => {
        const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
        await navigator.clipboard?.writeText(url);
        button.textContent = '✓';
        setTimeout(() => {
          button.textContent = '#';
        }, 1200);
      });
      heading.append(button);
    });
  const tocLinks = [...document.querySelectorAll('[data-toc-link]')];
  const tocHeadings: HTMLElement[] = tocLinks
    .map((link) => document.getElementById(link.getAttribute('data-toc-link') ?? ''))
    .filter((heading): heading is HTMLElement => heading instanceof HTMLElement);
  const setActiveToc = (id: string) =>
    tocLinks.forEach((link) => {
      const active = link.getAttribute('data-toc-link') === id;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  if (tocHeadings.length) {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActiveToc(entry.target.id);
        }),
      { rootMargin: '-18% 0px -68% 0px' },
    );
    tocHeadings.forEach((heading) => observer.observe(heading));
    setActiveToc(window.location.hash.slice(1) || tocHeadings[0].id);
  }
  const content = document.querySelector('.article-content');
  const readingStatus = document.querySelector('[data-reading-progress]');
  const readingProgressBar = document.querySelector<HTMLElement>('[data-reading-progress-bar]');
  const readingMinutes = Number(
    document.querySelector('[data-reading-minutes]')?.getAttribute('data-reading-minutes') ?? 1,
  );
  const updateReadingStatus = () => {
    if (!content || !readingStatus) return;
    const contentTop = content.getBoundingClientRect().top + window.scrollY;
    const contentEnd = contentTop + content.scrollHeight - window.innerHeight * 0.58;
    const progress = Math.min(
      1,
      Math.max(
        0,
        (window.scrollY + window.innerHeight * 0.22 - contentTop) /
          Math.max(1, contentEnd - contentTop),
      ),
    );
    const left = Math.max(0, Math.ceil(readingMinutes * (1 - progress)));
    readingStatus.textContent = `${left} min left · ${Math.round(progress * 100)}% read`;
    if (readingProgressBar) readingProgressBar.style.width = `${Math.round(progress * 100)}%`;
  };
  updateReadingStatus();
  window.addEventListener('scroll', updateReadingStatus, { passive: true });
  const copyArticleButton = document.querySelector<HTMLButtonElement>('[data-copy-article]');
  const shareFeedback = document.querySelector<HTMLElement>('[data-share-feedback]');
  const articleShareData = { title: document.title, url: window.location.href };
  const encodedTitle = encodeURIComponent(articleShareData.title);
  const encodedUrl = encodeURIComponent(articleShareData.url);
  document
    .querySelector<HTMLAnchorElement>('[data-share-x]')
    ?.setAttribute(
      'href',
      `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    );
  document
    .querySelector<HTMLAnchorElement>('[data-share-mastodon]')
    ?.setAttribute('href', `https://mastodon.social/share?text=${encodedTitle}%20${encodedUrl}`);
  document
    .querySelector<HTMLAnchorElement>('[data-share-linkedin]')
    ?.setAttribute('href', `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`);
  const copyArticleUrl = async () => {
    await navigator.clipboard?.writeText(articleShareData.url);
    if (shareFeedback) shareFeedback.textContent = 'Link copied';
    window.setTimeout(() => {
      if (shareFeedback) shareFeedback.textContent = '';
    }, 1600);
  };
  copyArticleButton?.addEventListener('click', copyArticleUrl);
  const diagrams = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]');
  if (diagrams.length) {
    import('mermaid').then(async ({ default: mermaid }) => {
      const containers: HTMLElement[] = [];
      const getThemeVariables = () => {
        const styles = getComputedStyle(document.documentElement);
        const color = (name: string) => styles.getPropertyValue(name).trim();
        const dark = document.documentElement.dataset.uiTheme === 'dark';

        return {
          background: color('--surface'),
          mainBkg: color('--elevated'),
          primaryColor: color('--elevated'),
          primaryTextColor: color('--text'),
          nodeTextColor: color('--text'),
          textColor: color('--text'),
          primaryBorderColor: color('--accent'),
          lineColor: color('--accent-hover'),
          secondaryColor: color('--surface'),
          tertiaryColor: color('--bg'),
          clusterBkg: color('--surface'),
          clusterBorder: color('--border'),
          edgeLabelBackground: color('--surface'),
          fontFamily: 'Geist Variable, sans-serif',
          darkMode: dark,
        };
      };
      const renderDiagrams = async () => {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: getThemeVariables(),
          securityLevel: 'strict',
        });
        for (const container of containers) {
          const source = container.getAttribute('data-mermaid-source') ?? '';
          container.replaceChildren();
          container.textContent = source;
          await mermaid.run({ nodes: [container], suppressErrors: true });
        }
      };
      [...diagrams].forEach((pre) => {
        const source = [...pre.querySelectorAll<HTMLElement>('.code')]
          .map((line) => line.textContent?.replace(/^\s*\d+\s*/, '').trimEnd() ?? '')
          .join('\n');
        const container = document.createElement('div');
        container.className = 'mermaid';
        container.setAttribute('role', 'img');
        container.setAttribute('aria-label', 'Architecture diagram');
        container.setAttribute('data-mermaid-source', source || pre.textContent || '');
        pre.replaceWith(container);
        containers.push(container);
      });
      await renderDiagrams();
      window.addEventListener('themechange', () => void renderDiagrams());
    });
  }
</script>
